import java.util.*;

class OnDemand { List l; void m() { l.mine(); } }
//- file main q/Outer.java
package q;

class Outer {
    static class X { void fromOuter() {} }
    static class Inner extends p.Base { X x; void m() { x.fromBase(); } }
}
