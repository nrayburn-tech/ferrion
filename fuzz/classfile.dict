# libFuzzer dictionary for the class file, zip, jar, jimage, and ct.sym fuzz targets: magic
# numbers, attribute names, and pieces of signatures that random mutation rarely produces. Pass it
# with `-dict=classfile.dict` (see "Fuzzing" in CONTRIBUTING.md).

# Magic numbers and signatures, in both byte orders where they vary.
"\xca\xfe\xba\xbe"
"\xda\xda\xfe\xca"
"\xca\xfe\xda\xda"
"\xfa\xfa\xfe\xca"
"\xca\xfe\xfa\xfa"
"PK\x03\x04"
"PK\x01\x02"
"PK\x05\x06"
"PK\x06\x06"
"PK\x06\x07"
"PK\x07\x08"
"\x01\x00\x18\x00"

# Attribute names.
"ConstantValue"
"Code"
"Exceptions"
"InnerClasses"
"EnclosingMethod"
"Synthetic"
"Signature"
"SourceFile"
"Deprecated"
"RuntimeVisibleAnnotations"
"RuntimeInvisibleAnnotations"
"RuntimeVisibleParameterAnnotations"
"RuntimeInvisibleParameterAnnotations"
"RuntimeVisibleTypeAnnotations"
"RuntimeInvisibleTypeAnnotations"
"AnnotationDefault"
"MethodParameters"
"Module"
"ModulePackages"
"ModuleMainClass"
"ModuleResolution"
"NestHost"
"NestMembers"
"Record"
"PermittedSubclasses"

# Signatures and descriptors.
"Ljava/lang/Object;"
"<T:Ljava/lang/Object;>"
"TT;"
"<*>"
"+Ljava/lang/Number;"
"-TT;"
".Inner<"
"^Ljava/io/IOException;"
"()V"
"[["

# Jars, ct.sym, and jimage.
"META-INF/MANIFEST.MF"
"META-INF/versions/"
"Multi-Release: true\x0a"
"Class-Path: "
"module-info"
".class"
".sig"
"system-modules"
"-modules/"
"java.base"
"compact-cp"
"zip"
