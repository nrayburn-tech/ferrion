# libFuzzer dictionary for the lexer fuzz targets: pieces of Java that random mutation rarely
# produces. Pass it with `-dict=java.dict` (see "Fuzzing" in CONTRIBUTING.md).

# Keywords and contextual keywords.
"abstract"
"boolean"
"class"
"const"
"default"
"enum"
"extends"
"final"
"goto"
"instanceof"
"interface"
"module"
"non-sealed"
"null"
"permits"
"record"
"sealed"
"strictfp"
"switch"
"true"
"var"
"when"
"yield"
"_"

# Comments.
"//"
"///"
"/*"
"/**"
"*/"
"/**/"

# Line terminators and whitespace.
"\x0a"
"\x0d"
"\x0d\x0a"
"\x09"
"\x0c"

# Quotes and escape sequences.
"\""
"\"\"\""
"\"\"\"\x0a"
"'"
"\\"
"\\n"
"\\s"
"\\'"
"\\\""
"\\\\"
"\\0"
"\\377"
"\\\x0a"

# Unicode escapes.
"\\u"
"\\uu"
"\\uuuu005c"
"\\u005c"
"\\u000a"
"\\u000d"
"\\u0022"
"\\u0027"
"\\u002f"
"\\u002a"
"\\u0063lass"
"\\uD83D\\uDE00"
"\\uD800"
"\\uDFFF"

# Numeric literals and their parts.
"0x"
"0X"
"0b"
"0B"
"0_"
"1_000"
"0x1p-3"
"0x1.8P1f"
"1e+"
"1E-"
".5"
"2147483648"
"9223372036854775808L"

# Separators and operators.
"..."
"::"
"->"
">>"
">>>="
"<<="
"=="
"!="
"&&"
"||"
"@"

# Characters that are easy to mishandle: a byte-order mark, a no-break space, a zero-width space,
# a line separator, a supplementary character, Ctrl-Z, and an invalid UTF-8 byte.
"\xef\xbb\xbf"
"\xc2\xa0"
"\xe2\x80\x8b"
"\xe2\x80\xa8"
"\xf0\x9f\x98\x80"
"\x1a"
"\xff"
