# libFuzzer dictionary for the doc comment fuzz targets, `javadoc` and `markdown`: pieces of doc
# comments that random mutation rarely produces. Pass it with `-dict=doc_comments.dict` (see
# "Fuzzing" in CONTRIBUTING.md).

# Comment syntax and line breaks.
"/**"
"*/"
"///"
"\x0a * "
"\x0a"
"\x0d\x0a"
"\x0d"
"\x09"
"\x0c"

# Block tags.
"@param "
"@param <T> "
"@return "
"@throws "
"@exception "
"@see "
"@see \""
"@see <a href=\""
"@serialField "
"@spec "
"@since "
"@deprecated "
"@hidden"
"@uses "
"@apiNote "
"@"

# Inline tags.
"{@"
"{@code "
"{@literal "
"{@link "
"{@linkplain "
"{@value "
"{@value %d "
"{@index \""
"{@summary "
"{@return "
"{@inheritDoc"
"{@docRoot}"
"{@systemProperty "
"{@snippet "
"{@snippet lang=java :\x0a"
"region=\""
"}"
"{"

# Escapes.
"@@"
"@*"
"*@/"
"\\{@"
"\\@"

# References.
"#"
"##"
"java.util.List#add(int, Object)"
"("
")"
","
"[]"
"\\[\\]"
"..."
"<?"
"? extends "
"java.base/"

# HTML.
"<pre>"
"</pre>"
"<a href=\""
"</a>"
"<b>"
"<br/>"
"<!--"
"-->"
"&amp;"
"&#64;"
"&#x40;"
"&"
"<"
">"
"='"

# Markdown.
"`"
"```"
"~~~"
"    "
"> "
"- "
"1. "
"* "
"**"
"_"
"# "
"==="
"---"
"***"
"| a |"
"|---|"
"|:-:|"
"["
"]"
"]["
"]("
"[List]"
"[a][List]"
"[d]: http://example.com"
"<div>"
"</div>"
"![i](u)"
"  \x0a"
"\\\x0a"

# Unicode escapes.
"\\u000a"
"\\u000d"
"\\u007d"
"\\u007b"
"\\u0040"
"\\u002a/"
"\\u002f"
"\\uD83D\\uDE00"
"\\u12"
"\\\\u0041"

# Characters that are easy to mishandle: a no-break space, a supplementary character, the
# Private Use Area character the Markdown parser uses as a placeholder, and an invalid byte.
"\xc2\xa0"
"\xf0\x9f\x98\x80"
"\xee\x80\x80"
"\xff"
