# javac --release 27, then Ferrion, both in javac's terms. Regenerate with `cargo oracle differences --bless`.
javac   CLASS 0..5 "class"
javac   IDENTIFIER 6..7 "A"
javac   LBRACE 8..9 "{"
javac   CHAR 12..16 "char"
javac   IDENTIFIER 17..18 "c"
javac   EQ 19..20 "="
javac   ERROR 21..23 "''"
javac   ERROR 23..37 "';\n  int x;\n}\n"
javac   EOF 37..37 ""
javac   error compiler.err.empty.char.lit at 21
ferrion CLASS 0..5 "class"
ferrion IDENTIFIER 6..7 "A"
ferrion LBRACE 8..9 "{"
ferrion CHAR 12..16 "char"
ferrion IDENTIFIER 17..18 "c"
ferrion EQ 19..20 "="
ferrion CHARLITERAL 21..23 "''"
ferrion CHARLITERAL 23..25 "';"
ferrion INT 28..31 "int"
ferrion IDENTIFIER 32..33 "x"
ferrion SEMI 33..34 ";"
ferrion RBRACE 35..36 "}"
ferrion EOF 37..37 ""
ferrion error EmptyCharLiteral 21..23 "''"
ferrion error UnterminatedCharLiteral 23..25 "';"
first difference at item 7
