# javac --release 27, then Ferrion, both in javac's terms. Regenerate with `cargo oracle differences --bless`.
javac   CLASS 0..5 "class"
javac   IDENTIFIER 6..7 "A"
javac   LBRACE 8..9 "{"
javac   IDENTIFIER 12..18 "String"
javac   IDENTIFIER 19..20 "s"
javac   EQ 21..22 "="
javac   ERROR 23..26 "\"\"\""
javac   IDENTIFIER 26..29 "abc"
javac   ERROR 29..32 "\"\"\""
javac   SEMI 32..33 ";"
javac   INT 36..39 "int"
javac   IDENTIFIER 40..41 "x"
javac   SEMI 41..42 ";"
javac   RBRACE 43..44 "}"
javac   EOF 45..45 ""
javac   error compiler.err.illegal.text.block.open at 26
javac   error compiler.err.illegal.text.block.open at 32
ferrion CLASS 0..5 "class"
ferrion IDENTIFIER 6..7 "A"
ferrion LBRACE 8..9 "{"
ferrion IDENTIFIER 12..18 "String"
ferrion IDENTIFIER 19..20 "s"
ferrion EQ 21..22 "="
ferrion STRINGLITERAL 23..32 "\"\"\"abc\"\"\""
ferrion SEMI 32..33 ";"
ferrion INT 36..39 "int"
ferrion IDENTIFIER 40..41 "x"
ferrion SEMI 41..42 ";"
ferrion RBRACE 43..44 "}"
ferrion EOF 45..45 ""
ferrion error TextBlockOpeningNotOnOwnLine 26..29 "abc"
first difference at item 7
