# javac --release 27, then Ferrion, both in javac's terms. Regenerate with `cargo oracle differences --bless`.
javac   CLASS 0..5 "class"
javac   IDENTIFIER 6..7 "A"
javac   LBRACE 8..9 "{"
javac   INT 12..15 "int"
javac   IDENTIFIER 16..17 "a"
javac   SEMI 17..18 ";"
javac   INT 24..27 "int"
javac   IDENTIFIER 28..29 "b"
javac   SEMI 29..30 ";"
javac   RBRACE 31..32 "}"
javac   EOF 33..33 ""
javac   error compiler.err.illegal.unicode.esc at 23
ferrion CLASS 0..5 "class"
ferrion IDENTIFIER 6..7 "A"
ferrion LBRACE 8..9 "{"
ferrion INT 12..15 "int"
ferrion IDENTIFIER 16..17 "a"
ferrion SEMI 17..18 ";"
ferrion ERROR 19..23 "\\u12"
ferrion INT 24..27 "int"
ferrion IDENTIFIER 28..29 "b"
ferrion SEMI 29..30 ";"
ferrion RBRACE 31..32 "}"
ferrion EOF 33..33 ""
ferrion error InvalidUnicodeEscape 19..23 "\\u12"
first difference at item 7
