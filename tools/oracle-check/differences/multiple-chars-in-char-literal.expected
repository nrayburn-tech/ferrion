# javac --release 27, then Ferrion, both in javac's terms. Regenerate with `cargo oracle differences --bless`.
javac   CLASS 0..5 "class"
javac   IDENTIFIER 6..7 "A"
javac   LBRACE 8..9 "{"
javac   CHAR 12..16 "char"
javac   IDENTIFIER 17..18 "c"
javac   EQ 19..20 "="
javac   ERROR 21..23 "'a"
javac   IDENTIFIER 23..24 "b"
javac   ERROR 24..26 "';"
javac   INT 29..32 "int"
javac   IDENTIFIER 33..34 "x"
javac   SEMI 34..35 ";"
javac   RBRACE 36..37 "}"
javac   EOF 38..38 ""
javac   error compiler.err.unclosed.char.lit at 21
javac   error compiler.err.unclosed.char.lit at 24
ferrion CLASS 0..5 "class"
ferrion IDENTIFIER 6..7 "A"
ferrion LBRACE 8..9 "{"
ferrion CHAR 12..16 "char"
ferrion IDENTIFIER 17..18 "c"
ferrion EQ 19..20 "="
ferrion CHARLITERAL 21..25 "'ab'"
ferrion SEMI 25..26 ";"
ferrion INT 29..32 "int"
ferrion IDENTIFIER 33..34 "x"
ferrion SEMI 34..35 ";"
ferrion RBRACE 36..37 "}"
ferrion EOF 38..38 ""
ferrion error MultipleCharsInCharLiteral 21..25 "'ab'"
first difference at item 7
