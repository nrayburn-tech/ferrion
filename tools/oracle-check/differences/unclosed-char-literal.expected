# javac --release 27, then Ferrion, both in javac's terms. Regenerate with `cargo oracle differences --bless`.
javac   CLASS 0..5 "class"
javac   IDENTIFIER 6..7 "A"
javac   LBRACE 8..9 "{"
javac   CHAR 12..16 "char"
javac   IDENTIFIER 17..18 "c"
javac   EQ 19..20 "="
javac   ERROR 21..23 "'a"
javac   SEMI 23..24 ";"
javac   INT 27..30 "int"
javac   IDENTIFIER 31..32 "x"
javac   SEMI 32..33 ";"
javac   RBRACE 34..35 "}"
javac   EOF 36..36 ""
javac   error compiler.err.unclosed.char.lit at 21
ferrion CLASS 0..5 "class"
ferrion IDENTIFIER 6..7 "A"
ferrion LBRACE 8..9 "{"
ferrion CHAR 12..16 "char"
ferrion IDENTIFIER 17..18 "c"
ferrion EQ 19..20 "="
ferrion CHARLITERAL 21..23 "'a"
ferrion SEMI 23..24 ";"
ferrion INT 27..30 "int"
ferrion IDENTIFIER 31..32 "x"
ferrion SEMI 32..33 ";"
ferrion RBRACE 34..35 "}"
ferrion EOF 36..36 ""
ferrion error UnterminatedCharLiteral 21..23 "'a"
first difference at item 7
