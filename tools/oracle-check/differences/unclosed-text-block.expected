# javac --release 27, then Ferrion, both in javac's terms. Regenerate with `cargo oracle differences --bless`.
javac   CLASS 0..5 "class"
javac   IDENTIFIER 6..7 "A"
javac   LBRACE 8..9 "{"
javac   IDENTIFIER 12..18 "String"
javac   IDENTIFIER 19..20 "s"
javac   EQ 21..22 "="
javac   ERROR 23..35 "\"\"\"\n    abc\n"
javac   IDENTIFIER 39..42 "def"
javac   SEMI 42..43 ";"
javac   INT 46..49 "int"
javac   IDENTIFIER 50..51 "x"
javac   SEMI 51..52 ";"
javac   RBRACE 53..54 "}"
javac   EOF 55..55 ""
javac   error compiler.err.unclosed.text.block at 23
ferrion CLASS 0..5 "class"
ferrion IDENTIFIER 6..7 "A"
ferrion LBRACE 8..9 "{"
ferrion IDENTIFIER 12..18 "String"
ferrion IDENTIFIER 19..20 "s"
ferrion EQ 21..22 "="
ferrion STRINGLITERAL 23..35 "\"\"\"\n    abc\n"
ferrion IDENTIFIER 39..42 "def"
ferrion SEMI 42..43 ";"
ferrion INT 46..49 "int"
ferrion IDENTIFIER 50..51 "x"
ferrion SEMI 51..52 ";"
ferrion RBRACE 53..54 "}"
ferrion EOF 55..55 ""
ferrion error UnterminatedTextBlock 23..26 "\"\"\""
first difference at item 7
