# javac --release 27, then Ferrion, both in javac's terms. Regenerate with `cargo oracle differences --bless`.
javac   CLASS 0..5 "class"
javac   IDENTIFIER 6..7 "A"
javac   LBRACE 8..9 "{"
javac   IDENTIFIER 12..18 "String"
javac   IDENTIFIER 19..20 "s"
javac   EQ 21..22 "="
javac   ERROR 23..29 "\"a\\qb\""
javac   SEMI 29..30 ";"
javac   INT 33..36 "int"
javac   IDENTIFIER 37..38 "x"
javac   SEMI 38..39 ";"
javac   RBRACE 40..41 "}"
javac   EOF 42..42 ""
javac   error compiler.err.illegal.esc.char at 26
ferrion CLASS 0..5 "class"
ferrion IDENTIFIER 6..7 "A"
ferrion LBRACE 8..9 "{"
ferrion IDENTIFIER 12..18 "String"
ferrion IDENTIFIER 19..20 "s"
ferrion EQ 21..22 "="
ferrion STRINGLITERAL 23..29 "\"a\\qb\""
ferrion SEMI 29..30 ";"
ferrion INT 33..36 "int"
ferrion IDENTIFIER 37..38 "x"
ferrion SEMI 38..39 ";"
ferrion RBRACE 40..41 "}"
ferrion EOF 42..42 ""
ferrion error InvalidEscape 25..27 "\\q"
first difference at item 7
