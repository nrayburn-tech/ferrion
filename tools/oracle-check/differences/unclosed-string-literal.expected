# javac --release 27, then Ferrion, both in javac's terms. Regenerate with `cargo oracle differences --bless`.
javac   CLASS 0..5 "class"
javac   IDENTIFIER 6..7 "A"
javac   LBRACE 8..9 "{"
javac   IDENTIFIER 12..18 "String"
javac   IDENTIFIER 19..20 "s"
javac   EQ 21..22 "="
javac   ERROR 23..28 "\"abc;"
javac   INT 31..34 "int"
javac   IDENTIFIER 35..36 "x"
javac   SEMI 36..37 ";"
javac   RBRACE 38..39 "}"
javac   EOF 40..40 ""
javac   error compiler.err.unclosed.str.lit at 23
ferrion CLASS 0..5 "class"
ferrion IDENTIFIER 6..7 "A"
ferrion LBRACE 8..9 "{"
ferrion IDENTIFIER 12..18 "String"
ferrion IDENTIFIER 19..20 "s"
ferrion EQ 21..22 "="
ferrion STRINGLITERAL 23..28 "\"abc;"
ferrion INT 31..34 "int"
ferrion IDENTIFIER 35..36 "x"
ferrion SEMI 36..37 ";"
ferrion RBRACE 38..39 "}"
ferrion EOF 40..40 ""
ferrion error UnterminatedStringLiteral 23..28 "\"abc;"
first difference at item 7
