# javac --release 27, then Ferrion, both in javac's terms. Regenerate with `cargo oracle differences --bless`.
javac   CLASS 0..5 "class"
javac   IDENTIFIER 6..7 "A"
javac   LBRACE 8..9 "{"
javac   INT 12..15 "int"
javac   IDENTIFIER 16..17 "a"
javac   EQ 18..19 "="
javac   INTLITERAL 20..22 "0x"
javac   SEMI 22..23 ";"
javac   DOUBLE 26..32 "double"
javac   IDENTIFIER 33..34 "b"
javac   EQ 35..36 "="
javac   DOUBLELITERAL 37..40 "1e+"
javac   SEMI 40..41 ";"
javac   INT 44..47 "int"
javac   IDENTIFIER 48..49 "c"
javac   EQ 50..51 "="
javac   INTLITERAL 52..58 "0b1012"
javac   SEMI 58..59 ";"
javac   INT 62..65 "int"
javac   IDENTIFIER 66..67 "d"
javac   EQ 68..69 "="
javac   INTLITERAL 70..72 "1_"
javac   SEMI 72..73 ";"
javac   DOUBLE 76..82 "double"
javac   IDENTIFIER 83..84 "e"
javac   EQ 85..86 "="
javac   ERROR 87..90 "0x."
javac   IDENTIFIER 90..92 "p1"
javac   SEMI 92..93 ";"
javac   RBRACE 94..95 "}"
javac   EOF 96..96 ""
javac   error compiler.err.invalid.hex.number at 20
javac   error compiler.err.malformed.fp.lit at 37
javac   error compiler.err.illegal.underscore at 71
javac   error compiler.err.invalid.hex.number at 87
ferrion CLASS 0..5 "class"
ferrion IDENTIFIER 6..7 "A"
ferrion LBRACE 8..9 "{"
ferrion INT 12..15 "int"
ferrion IDENTIFIER 16..17 "a"
ferrion EQ 18..19 "="
ferrion INTLITERAL 20..22 "0x"
ferrion SEMI 22..23 ";"
ferrion DOUBLE 26..32 "double"
ferrion IDENTIFIER 33..34 "b"
ferrion EQ 35..36 "="
ferrion DOUBLELITERAL 37..40 "1e+"
ferrion SEMI 40..41 ";"
ferrion INT 44..47 "int"
ferrion IDENTIFIER 48..49 "c"
ferrion EQ 50..51 "="
ferrion INTLITERAL 52..58 "0b1012"
ferrion SEMI 58..59 ";"
ferrion INT 62..65 "int"
ferrion IDENTIFIER 66..67 "d"
ferrion EQ 68..69 "="
ferrion INTLITERAL 70..72 "1_"
ferrion SEMI 72..73 ";"
ferrion DOUBLE 76..82 "double"
ferrion IDENTIFIER 83..84 "e"
ferrion EQ 85..86 "="
ferrion DOUBLELITERAL 87..90 "0x."
ferrion IDENTIFIER 90..92 "p1"
ferrion SEMI 92..93 ";"
ferrion RBRACE 94..95 "}"
ferrion EOF 96..96 ""
ferrion error MalformedNumber 20..22 "0x"
ferrion error MalformedNumber 37..40 "1e+"
ferrion error MalformedNumber 57..58 "2"
ferrion error MalformedNumber 71..72 "_"
ferrion error MalformedNumber 87..90 "0x."
first difference at item 27
