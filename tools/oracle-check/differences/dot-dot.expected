# javac --release 27, then Ferrion, both in javac's terms. Regenerate with `cargo oracle differences --bless`.
javac   CLASS 0..5 "class"
javac   IDENTIFIER 6..7 "A"
javac   LBRACE 8..9 "{"
javac   INT 12..15 "int"
javac   IDENTIFIER 16..17 "x"
javac   EQ 18..19 "="
javac   IDENTIFIER 20..21 "a"
javac   ERROR 21..23 ".."
javac   IDENTIFIER 23..24 "b"
javac   SEMI 24..25 ";"
javac   RBRACE 26..27 "}"
javac   EOF 28..28 ""
javac   error compiler.err.illegal.dot at 22
ferrion CLASS 0..5 "class"
ferrion IDENTIFIER 6..7 "A"
ferrion LBRACE 8..9 "{"
ferrion INT 12..15 "int"
ferrion IDENTIFIER 16..17 "x"
ferrion EQ 18..19 "="
ferrion IDENTIFIER 20..21 "a"
ferrion DOT 21..22 "."
ferrion DOT 22..23 "."
ferrion IDENTIFIER 23..24 "b"
ferrion SEMI 24..25 ";"
ferrion RBRACE 26..27 "}"
ferrion EOF 28..28 ""
first difference at item 8
